all: main.pdf

# The PDF carries the git revision it was built from. version.tex is
# regenerated on every build from git; if git is unavailable the previous
# file (committed alongside main.pdf) is kept, so the build never fails.
# "dirty" means uncommitted changes under paper/, spec/, formal/ or tools/,
# excluding the PDF and version.tex themselves, so that rebuilding the PDF
# after committing the sources yields a clean stamp naming that commit.
version.tex: FORCE
	@if git rev-parse --git-dir >/dev/null 2>&1; then \
	  h=$$(git log -1 --format=%h); d=$$(git log -1 --format=%cs); \
	  desc=$$(git describe --tags --always 2>/dev/null || echo $$h); \
	  dirty=$$(git diff --quiet -- . ../spec ../formal ../tools ':(exclude)main.pdf' ':(exclude)version.tex' 2>/dev/null && echo clean || echo dirty); \
	  test $$dirty = clean || desc=$$desc-dirty; \
	  printf '%%%% generated by make; do not edit\n\\newcommand{\\GitHash}{%s}\n\\newcommand{\\GitDate}{%s}\n\\newcommand{\\GitDescribe}{%s}\n\\newcommand{\\GitState}{%s}\n' \
	    "$$h" "$$d" "$$desc" "$$dirty" > version.tex.new; \
	  if ! cmp -s version.tex.new version.tex; then mv version.tex.new version.tex; else rm -f version.tex.new; fi; \
	fi; \
	test -f version.tex || printf '\\newcommand{\\GitHash}{unknown}\n\\newcommand{\\GitDate}{unknown}\n\\newcommand{\\GitDescribe}{unknown}\n\\newcommand{\\GitState}{unknown}\n' > version.tex

listings: ../tools/gen_structured.py ../tools/layertree_scripts.py ../tools/layertree_mid.py ../tools/layertree_min.py
	python3 ../tools/gen_structured.py

main.pdf: main.tex refs.bib appendix-*.tex version.tex $(wildcard ../spec/scripts/structured/*.txt)
	latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex

clean:
	latexmk -C; rm -f *.bbl *.run.xml

FORCE:
.PHONY: all clean listings FORCE
